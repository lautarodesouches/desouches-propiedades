        <meta name="keywords" content="inmobiliaria, propiedades, casas, departamentos, terrenos, quintas, alquiler, venta, tasaciones, Argentina, Desouches, inmuebles, oficinas, locales comerciales, galpones, campos" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="author" content="Desouches Propiedades" />
        <link rel="canonical" href="https://desouchespropiedades.com.ar/" />
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://desouchespropiedades.com.ar/" />
        <meta property="og:title" content="Desouches Propiedades - Tu Inmobiliaria de Confianza" />
        <meta property="og:description" content="Encontrá la propiedad perfecta para vos. Venta, alquiler y tasaciones profesionales de casas, departamentos, terrenos y propiedades comerciales en Argentina." />
        <meta property="og:image" content="https://desouchespropiedades.com.ar/assets/logo.png" />
        <meta property="og:locale" content="es_AR" />
        <meta property="og:site_name" content="Desouches Propiedades" />
        
        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content="https://desouchespropiedades.com.ar/" />
        <meta name="twitter:title" content="Desouches Propiedades - Tu Inmobiliaria de Confianza" />
        <meta name="twitter:description" content="Encontrá la propiedad perfecta para vos. Venta, alquiler y tasaciones profesionales." />
        <meta name="twitter:image" content="https://desouchespropiedades.com.ar/assets/logo.png" />
        
		<link rel="icon" type="image/x-icon" href="/assets/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
         <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-LKL5CKRM87"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-LKL5CKRM87');
        </script>
        
        <!-- Schema.org Structured Data (JSON-LD) -->
        <script type="application/ld+json" is:inline>
        {
            "@context": "https://schema.org",
            "@type": "RealEstateAgent",
            "name": "Desouches Propiedades",
            "image": "https://desouchespropiedades.com.ar/assets/logo.png",
            "url": "https://desouchespropiedades.com.ar",
            "telephone": "+54-11-6995-2960",
            "email": "desouchespropiedades@gmail.com",
            "address": {
                "@type": "PostalAddress",
                "addressCountry": "AR",
                "addressLocality": "Argentina"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": -34.6037,
                "longitude": -58.3816
            },
            "sameAs": [
                "https://www.facebook.com/people/Desouches-Propiedades/100093328701006/",
                "https://www.instagram.com/desouchespropiedades/",
                "https://www.zonaprop.com.ar/inmobiliarias/desouches-propiedades.html"
            ],
            "priceRange": "$$",
            "openingHoursSpecification": {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                    "Monday",
                    "Tuesday",
                    "Wednesday",
                    "Thursday",
                    "Friday"
                ],
                "opens": "09:00",
                "closes": "18:00"
            },
            "areaServed": {
                "@type": "Country",
                "name": "Argentina"
            },
            "serviceType": [
                "Venta de propiedades",
                "Alquiler de propiedades",
                "Tasaciones inmobiliarias",
                "Asesoramiento inmobiliario"
            ]
        }
        </script>
        
        <script>
            // Scroll Reveal Animation Script
            document.addEventListener('DOMContentLoaded', () => {
                const observerOptions = {
                    root: null,
                    rootMargin: '0px',
                    threshold: 0.1
                };

                const observer = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('reveal-visible');
                            observer.unobserve(entry.target); // Only animate once
                        }
                    });
                }, observerOptions);

                const revealElements = document.querySelectorAll('.reveal');
                revealElements.forEach(el => observer.observe(el));
            });
        </script>
	</head>
	<body>
		<slot />
	</body>
</html>

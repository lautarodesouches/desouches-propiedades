---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="description" content="Desouches propiedades" />
        <meta name="keywords" content="Desouches propiedades, Inmobiliaria Desouches" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots"  content="index,follow"  />
		<link rel="icon" type="image/x-icon" href="/assets/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
         <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-LKL5CKRM87"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-LKL5CKRM87');
        </script>
	</head>
	<body>
		<slot />
	</body>
</html>
